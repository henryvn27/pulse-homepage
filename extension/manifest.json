{
  "manifest_version": 3,
  "name": "Pulse",
  "version": "1.0.0",
  "description": "A calm Safari homepage for GitHub Projects, Calendar, Reminders, weather, and shortcuts.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
